# --- Secrets ---
.env
.env.*
!.env.example
server/.env
server/.env.*

# --- Private data (NOT for the public repo) ---
# The wiki is generated from raw sources containing personal info from
# Discord, application form responses, etc. Both are excluded.
wiki/
raw/

# Inbox: staging area for sources being ingested into the wiki.
# `inbox/unprocessed/` = waiting to be ingested. `inbox/processed/` = done.
# `inbox/utils/` holds the rerunnable ingest scripts (no PII), but the whole
# tree is excluded because in practice items spend most of their time in
# processed/ alongside their snapshots, and one ignore rule is simpler.
inbox/

# Generated interview artifacts (transcripts, notes, user submissions)
server/transcripts/
server/notes/
server/human_requests/
server/newsletter_subscriptions/

# --- Python ---
__pycache__/
*.py[oc]
.venv/
server/.venv/
build/
dist/
*.egg-info/

# --- Node / SvelteKit ---
node_modules/
.svelte-kit/
.vercel/

# --- Editor / OS ---
.DS_Store
*.swp
.idea/
.vscode/
.claude/
